# Copy to ~/.config/dd-print-worker/env and chmod 600. NOT read from the repo.
#
# Secret: op://DEV/dd.printworker/credential   (API_CREDENTIAL item, DEV vault)
# Rotation touches THREE places and must be done together, or every print 401s:
#   1. the 1Password item
#   2. ~/.config/dd-print-worker/env on dd-mini  (then restart the LaunchAgent)
#   3. PRINT_WORKER_TOKEN in slime's Vercel env
PRINT_WORKER_TOKEN=

# Optional. Default 1530 (DD range 1500-1599). Changing it also requires
# editing the `service:` line in ~/.cloudflared/config.yml and restarting
# cloudflared — the public hostname print.dosscodesigns.com does not change.
# PRINT_WORKER_PORT=1530

# Optional. Prints per minute, counted AFTER auth. Default 30.
# PRINT_WORKER_RATE_MAX=30
